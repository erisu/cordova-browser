<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    id="cordova-plugin-fake-plugin"
    version="1.0.0">
    <name>Fake Plugin</name>
    <description>Cordova Fake Plugin</description>
    <license>Apache 2.0</license>
    <keywords>cordova</keywords>

    <!-- Test Case 1: Copies to www dir -->
    <asset src="assets/ServiceWorker.txt" target="ServiceWorker.txt" />
    <!-- Test Case 2: Makes js/deepdown directory then copies file -->
    <asset src="assets/reformat1.txt" target="js/deepdown/reformat1.txt" />
    <asset src="assets/reformat2.txt" target="js/deepdown/reformat2.txt" />
    <!-- Test Case 3: recursive copies -->
    <asset src="assets/folder" target="folder" />
</plugin>
